(version 1)

# JLCPCB JLC04161H-7628 4-layer, no-surcharge limits with margin.
# Net class names: RF = 50 ohm CPWG (L1 over L2), USB_90, ANALOG_BB, Power, PWR_BATT.

(rule "PTH to track"
  (constraint hole_clearance (min 0.35mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'"))

(rule "Hole to hole, different nets"
  (constraint hole_to_hole (min 0.55mm))
  (condition "A.Net != B.Net"))

(rule "PTH pad annular ring"
  (constraint annular_width (min 0.25mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))

(rule "NPTH minimum"
  (constraint hole_size (min 0.5mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'"))

(rule "Pad to track"
  (constraint clearance (min 0.2mm))
  (condition "A.Type == 'Pad' && B.Type == 'Track'"))

(rule "No micro or blind/buried vias"
  (constraint disallow micro_via buried_via))

(rule "RF_50 width"
  (condition "A.NetClass == 'RF'")
  (constraint track_width (min 0.25mm) (opt 0.29mm) (max 0.30mm)))

(rule "RF_50 CPWG gap"
  (constraint clearance (min 0.20mm))
  (condition "A.NetClass == 'RF' && B.Type == 'Zone'"))

(rule "LO pair skew"
  (condition "A.NetClass == 'RF' && A.inDiffPair('/Receiver/LO_*')")
  (constraint skew (max 0.1mm)))

(rule "USB_90 pair"
  (condition "A.NetClass == 'USB_90'")
  (constraint track_width (opt 0.20mm))
  (constraint diff_pair_gap (opt 0.12mm))
  (constraint diff_pair_uncoupled (max 3mm)))

(rule "USB_90 pour keepback"
  (constraint clearance (min 0.5mm))
  (condition "A.NetClass == 'USB_90' && B.Type == 'Zone'"))

# Edge-launch SMAs (Molex 73251-1153) sit on the board edge.
(rule "SMA edge launch"
  (constraint edge_clearance (min 0mm))
  (condition "A.memberOfFootprint('J6*') || A.memberOfFootprint('J7*')"))

# 0.5 mm-pitch IC pins: the pad gap is 0.24 mm, below the ANALOG_BB class clearance (0.25).
# Inside the IC courtyards clearance falls back to 0.15 mm (JLC min 0.09).
(rule "Fine-pitch IC escape"
  (constraint clearance (min 0.15mm))
  (condition "A.intersectsCourtyard('DEMOD701') || A.intersectsCourtyard('PLL601')"))

# EP thermal vias (0.6/0.3) in the MAX2871 and ADL5380 footprints are vias, not component PTH pads.
(rule "EP thermal vias"
  (constraint annular_width (min 0.15mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (A.memberOfFootprint('PLL*') || A.memberOfFootprint('DEMOD*'))"))

# ---- added 2026-11-15 with the first placement pass ----
# Impedances from a 2D field solve of JLC04161H-7628 (L1-L2 prepreg 0.2104 mm, er 4.4, 1 oz outer,
# 13 um mask): 50R CPWG = 0.28 mm / 0.20 mm gap (current RF_50 rule is within 1 ohm);
# 100R coupled CPWG = 0.19 mm / 0.20 mm gap / 0.20 mm to ground; 90R = 0.19 mm / 0.15 mm gap.
(rule "LO_100 coupled pair"
  (condition "A.NetClass == 'RF' && A.inDiffPair('/Receiver/LO_*')")
  (constraint track_width (min 0.17mm) (opt 0.19mm) (max 0.21mm))
  (constraint diff_pair_gap (min 0.18mm) (opt 0.20mm) (max 0.22mm)))

(rule "USB_90 pair geometry"
  (condition "A.NetClass == 'USB_90'")
  (constraint track_width (opt 0.19mm))
  (constraint diff_pair_gap (opt 0.15mm)))

# SMA launch: the 2.29 mm centre pad is ~13 ohm over L2. L2 is cut out under it (rule area in the
# board) and L3 carries a GND island, giving ~46-48 ohm when the L1 pour stays >= 1.2 mm away.
(rule "SMA centre pad keepback"
  (condition "A.Type == 'Pad' && A.Pad_Number == '1' && (A.memberOfFootprint('J601') || A.memberOfFootprint('J602') || A.memberOfFootprint('J701')) && B.Type == 'Zone'")
  (constraint clearance (min 1.2mm)))

# Footprint-internal pad gaps below the power-class clearances (USB-C 0.5 mm pitch, QFN EP, SOT-583).
(rule "Fine-pitch power IC escape"
  (constraint clearance (min 0.15mm))
  (condition "A.intersectsCourtyard('USB201') || A.intersectsCourtyard('CHG201') || A.intersectsCourtyard('BUCK301') || A.intersectsCourtyard('BUCK302')"))

(rule "USB-C peg holes"
  (constraint hole_clearance (min 0.15mm))
  (condition "A.memberOfFootprint('USB201') || B.memberOfFootprint('USB201')"))

# Footprint thermal-via arrays (0.2 mm drill) in the TPS7A8300, BQ25883 and ESP32 footprints are accepted
# as-is (Carter, 2026-11-15); JST PH / USB-C footprint annular rings are the vendor land patterns.
(rule "Footprint thermal vias"
  (constraint hole_size (min 0.2mm))
  (constraint annular_width (min 0.15mm))
  (condition "A.Type == 'Pad' && (A.memberOfFootprint('LDO30*') || A.memberOfFootprint('CHG201') || A.memberOfFootprint('MCU401'))"))

(rule "Vendor THT land patterns"
  (constraint annular_width (min 0.1mm))
  (condition "A.Type == 'Pad' && (A.memberOfFootprint('J203') || A.memberOfFootprint('J301') || A.memberOfFootprint('USB201'))"))
