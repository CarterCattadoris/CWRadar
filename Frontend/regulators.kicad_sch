	(text "SW301 only switches EN_BUCK (no load current); charging continues when OFF.\nEN divider, both EN pins in parallel (Ip, Ih doubled), DS Eq. 3-5:\nR1 = 113k, R2 = 30.9k -> start 5.48 V, stop 4.97 V; VEN at 8.8 V = 2.0 V (< 5.5 V, abs max 6 V)."
		(exclude_from_sim no)
		(at 15.24 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2756494b-388b-5f7b-85f3-06a922477737")
	)
