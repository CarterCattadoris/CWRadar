	(text "4k7 I2C pull-ups (charger + display header): the only ones.\nEN_ANALOG 100k pull-down: LNA starts off."
		(exclude_from_sim no)
		(at 256.54 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "04ab5c17-3ee2-5c23-b878-0747eb50379c")
	)
	(text "33R source termination at the ESP32. MCLK = GPIO12, BCK = GPIO13, LRCK = GPIO14."
		(exclude_from_sim no)
		(at 15.24 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1c00b511-bb0c-59f8-88fa-fad0b0337c90")
	)
	(text "Straps: GPIO0 BOOT (pull-up + SW402), GPIO3 and GPIO45 unused (no pull-up),\nGPIO46 = STATUS_LED (LED + R to GND only: reads low at boot). GPIO26-32 are not module pins.\nN16R2 (quad PSRAM): GPIO35-37 are free spares (NC). Pad-JTAG GPIO39-42 used: debug via USB-JTAG."
		(exclude_from_sim no)
		(at 134.62 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "35be1079-6e2b-5bba-8e88-57b569129485")
	)
