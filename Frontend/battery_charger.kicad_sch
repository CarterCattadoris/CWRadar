	(text "Generic pack leads vary in polarity — verify pin 1 = + before connecting.\nPack has a built-in BMS: no on-board cell protection, no VBAT divider (BQ25883 ADC reads VBAT/VSYS).\nQ201: drain to F201, source to +VBAT; body-diode anode toward J201.\nCorrect polarity: VGS = -VBAT (-6 to -8.4 V, inside ±12 V), on both ways. Reversed: off, diode blocks."
		(exclude_from_sim no)
		(at 15.24 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c86a4e33-8530-5bdb-bc5d-52d87307e4ca")
	)
